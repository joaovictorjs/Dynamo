<UserControl
    x:Class="Dynamo.Presentation.Views.FieldsPanelView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="260"
    mc:Ignorable="d">
    <Grid RowDefinitions="Auto, *">
        <Border
            Grid.Row="0"
            Height="{DynamicResource PanelHeaderHeight}"
            Padding="{DynamicResource PanelHeaderPadding}"
            BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="*, Auto">
                <TextBlock
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Text="Campos" />

                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="4">
                    <Button>
                        <LucideIcon Kind="Plus" />
                        <Button.Flyout>
                            <MenuFlyout>
                                <MenuItem Header="Bloco de texto" />
                                <MenuItem Header="Caixa de texto" />
                                <MenuItem Header="Seletor de data em calendário" />
                                <MenuItem Header="Caixa de seleção" />
                                <MenuItem Header="Espaçamento" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>

                    <Button>
                        <LucideIcon Kind="Trash" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
