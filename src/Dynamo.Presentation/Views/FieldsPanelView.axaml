<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="260" d:DesignHeight="450"
             x:Class="Dynamo.Presentation.Views.FieldsPanelView">
    <Grid RowDefinitions="Auto, *">
        <Border Grid.Row="0"
                Height="{DynamicResource PanelHeaderHeight}"
                Padding="{DynamicResource PanelHeaderPadding}"
                BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
            <Grid ColumnDefinitions="*, Auto">
                <TextBlock Grid.Column="0"
                           Text="Campos"
                           VerticalAlignment="Center" />

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="4"
                            VerticalAlignment="Center">
                    <Button>
                        <LucideIcon Kind="Plus" Size="16" />
                        <Button.Flyout>
                            <MenuFlyout>
                                <MenuItem Header="Bloco de texto" />
                                <MenuItem Header="Caixa de texto" />
                                <MenuItem Header="Seletor de data em calendário" />
                                <MenuItem Header="Caixa de seleção" />
                                <MenuItem Header="Espaçamento" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>

                    <Button>
                        <LucideIcon Kind="Trash" Size="16" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
