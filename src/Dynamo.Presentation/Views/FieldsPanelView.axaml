<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="260" d:DesignHeight="450"
             x:Class="Dynamo.Presentation.Views.FieldsPanelView">
    <Grid RowDefinitions="Auto, *">
        <Border Grid.Row="0"
                Height="{DynamicResource PanelHeaderHeight}"
                Padding="{DynamicResource PanelHeaderPadding}"
                BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
            <TextBlock Text="Campos"
                       VerticalAlignment="Center" />
        </Border>
    </Grid>
</UserControl>
