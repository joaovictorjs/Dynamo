<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Dynamo.Presentation.ViewModels"
        xmlns:views="using:Dynamo.Presentation.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="Dynamo.Presentation.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Dynamo.Presentation">

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainViewModel />
    </Design.DataContext>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="260" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="3*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" MinWidth="260" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                BorderThickness="0,0,1,0"
                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
            <views:FieldsPanelView />
        </Border>

        <GridSplitter Grid.Column="1"
                      Width="4"
                      ResizeDirection="Columns" />

        <views:PreviewPanelView Grid.Column="2" />

        <GridSplitter Grid.Column="3"
                      Width="4"
                      ResizeDirection="Columns" />

        <Border Grid.Column="4"
                BorderThickness="1,0,0,0"
                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
            <views:FieldParametersPanelView />
        </Border>
    </Grid>
</Window>
