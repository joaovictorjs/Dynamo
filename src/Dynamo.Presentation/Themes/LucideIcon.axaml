<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ControlTheme x:Key="{x:Type LucideIcon}"
                  TargetType="LucideIcon">
        <Setter Property="Size" Value="16" />
    </ControlTheme>
</ResourceDictionary>
